# Copia questo file in .env per lo sviluppo locale.
# Usa solo chiave publishable/anon. Mai SUPABASE_SERVICE_ROLE_KEY nel frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_VIXSRC_BASE_URL=https://vixsrc.to

# Secrets solo Edge Functions (impostare con `supabase secrets set`, mai usare VITE_*)
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.example
ALLOWED_ORIGIN_SUFFIXES=-your-vercel-account.vercel.app
RELEASE_REFRESH_SECRET=generate-a-long-random-secret
